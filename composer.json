{
    "name": "drabek-digital/captcha",
    "description": "🤖 Nette Forms extension for Cloudflare Turnstile and hCaptcha integration",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Drabek Digital",
            "email": "info@drabek.digital"
        }
    ],
    "require": {
        "php": "^8.3",
        "nette/forms": "^3.2",
        "nette/di": "^3.1",
        "nette/http": "^3.3",
        "nette/php-generator": "^3.5.4 || ^4.0",
        "nette/schema": "^1.2.5",
        "nette/utils": "^4.0.4"
    },
    "suggest": {
        "ext-curl": "Used for server-side verification requests, falls back to PHP streams (allow_url_fopen) without it"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0",
        "symplify/easy-coding-standard": "^13.0",
        "phpstan/phpstan": "^2.0",
        "spaze/phpstan-disallowed-calls": "^4.0",
        "spaze/phpstan-disallowed-calls-nette": "^3.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/extension-installer": "^1.2",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "DrabekDigital\\Captcha\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DrabekDigital\\Captcha\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "stan": "./vendor/bin/phpstan analyse src tests",
        "unit": "./vendor/bin/phpunit tests",
        "e2e": "./vendor/bin/phpunit tests --group e2e",
        "sniff": "./vendor/bin/ecs check src tests",
        "sniff-fix": "./vendor/bin/ecs check src tests --fix",
        "all": [
            "composer sniff",
            "composer stan",
            "composer unit"
        ]
    }
}
